# Copy to .env.local and fill in from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# These two are safe to expose in the browser bundle: the anon key only grants
# what Row Level Security allows. Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The shared household account, created once under
#   Supabase -> Authentication -> Users -> Add user.
# Sign-in asks only for the password; this address is the identifier behind it.
# It never receives mail, so it does not need to be a real inbox.
VITE_HOUSEHOLD_EMAIL=household@bauer.home
